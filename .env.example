# --- Supabase -------------------------------------------------------------
# Project URL and anon key are public by design; row level security is the
# actual boundary. Never ship the service role key to the browser.
# Newer projects label the public key "publishable". If both public keys are
# set, the publishable key is used. The legacy anon key still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form (Resend) ------------------------------------------------
RESEND_API_KEY=
# Example Resend sandbox sender. Replace with your verified domain sender.
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=you@example.com

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact rate limit (optional) ----------------------------------------
# In-memory only. These do not enable a shared store across server instances.
# Invalid values fall back to 5 requests per 10 minutes.
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Guest journal rate limit (optional) ----------------------------------
# In-memory only, same as the contact form. Invalid values fall back to 8
# attempts per 10 minutes. This does not enable a shared store.
# JOURNAL_RATE_LIMIT_MAX=8
# JOURNAL_RATE_LIMIT_WINDOW_SECONDS=600
